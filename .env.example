# Public Supabase settings (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase settings. NEVER prefix these with NEXT_PUBLIC_
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy alternative accepted by the current server code:
SUPABASE_SERVICE_ROLE_KEY=
