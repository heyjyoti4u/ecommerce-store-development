# Public Supabase settings (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL=
# Use the newer publishable key OR the legacy anon key. The app supports either.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase settings. NEVER prefix these with NEXT_PUBLIC_
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy alternative accepted by server code:
SUPABASE_SERVICE_ROLE_KEY=

# Stripe UPI Checkout (server-only)
STRIPE_SECRET_KEY=
